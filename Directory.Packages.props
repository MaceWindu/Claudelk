<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime dependencies -->
  <ItemGroup>
    <PackageVersion Include="InTheHand.BluetoothLE" Version="4.0.44" />
  </ItemGroup>

  <!-- Analyzers (added to every project via Directory.Build.props) -->
  <ItemGroup>
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.205" />
    <PackageVersion Include="AsyncFixer" Version="1.6.0" />
  </ItemGroup>

  <!-- Test dependencies (referenced from test projects only) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="NUnit" Version="4.6.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.13.0" />
  </ItemGroup>

</Project>
